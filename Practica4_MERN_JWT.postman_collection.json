	"item": [
		{
			"name": "1. Autenticación (Auth)",
			"item": [
				{
					"name": "1.1 Login Administrador (Genera JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado HTTP 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Token JWT generado', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.token).to.be.a('string');",
									"    pm.environment.set('admin_token', jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@unemi.edu.ec\",\n  \"password\": \"AdminPassword123*\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "1.2 Login Usuario Estándar (Genera JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado HTTP 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Token JWT usuario guardado', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.user.role).to.eql('usuario');",
									"    pm.environment.set('user_token', jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"estudiante@unemi.edu.ec\",\n  \"password\": \"UserPassword123*\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "1.3 Registro de Nuevo Usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado HTTP 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Rol asignado es usuario', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.user.role).to.eql('usuario');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Luis Peñafiel Alumno\",\n  \"email\": \"luis.penafiel@unemi.edu.ec\",\n  \"password\": \"AlumnoPassword123*\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "1.4 Consultar Perfil con Token Válido",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado HTTP 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('No expone contraseña', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.user.password).to.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/perfil",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"perfil"
							]
						}
					}
				},
				{
					"name": "1.5 Rechazo a Perfil sin Token (401 Unauthorized)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado HTTP 401 Unauthorized', function () {",
									"    pm.response.to.have.status(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/perfil",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"perfil"
							]
						}
					}
				}
			]
