{
	"info": {
		"_postman_id": "c1f7a83d-9d41-4518-bfae-e28e679c13b2",
		"name": "UNEMI - Práctica 4 Full Stack MERN con JWT",
		"description": "Colección completa de pruebas para la API REST desarrollada con Node.js, Express, MongoDB y autenticación JWT con control de acceso RBAC.",
