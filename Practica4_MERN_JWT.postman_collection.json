		{
			"name": "2. Catálogo y CRUD de Productos",
			"item": [
				{
					"name": "2.1 Listar Productos (Público)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/productos",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"productos"
							]
						}
					}
				},
				{
					"name": "2.2 Crear Producto (Admin - 201 Created)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado HTTP 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Producto creado con ID válido', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data._id).to.be.a('string');",
									"    pm.environment.set('created_product_id', jsonData.data._id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Tablet Gráfica Wacom Intuos Pro M\",\n  \"description\": \"Área activa 8.7 x 5.8 pulgadas con 8192 niveles de presión\",\n  \"category\": \"Accesorios\",\n  \"price\": 349.99,\n  \"stock\": 10,\n  \"sku\": \"WAC-INT-M01\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/productos",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"productos"
							]
						}
					}
				},
				{
					"name": "2.3 Rechazo de Creación con Rol Usuario (403 Forbidden)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado HTTP 403 Forbidden', function () {",
									"    pm.response.to.have.status(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Intento no autorizado\",\n  \"description\": \"Debe ser bloqueado\",\n  \"category\": \"Software\",\n  \"price\": 100,\n  \"stock\": 1,\n  \"sku\": \"FORBIDDEN-01\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/productos",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"productos"
							]
						}
					}
				},
				{
					"name": "2.4 Actualizar Producto (Admin - 200 OK)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"price\": 329.99,\n  \"stock\": 15\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/productos/{{created_product_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"productos",
								"{{created_product_id}}"
							]
						}
					}
				},
				{
					"name": "2.5 Eliminar Producto (Admin - 200 OK)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/productos/{{created_product_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"productos",
								"{{created_product_id}}"
							]
						}
					}
				}
			]
